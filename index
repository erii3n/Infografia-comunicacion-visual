        let attemptsLeft = 3;
        let isGameOver = false;

        function initUnifiedGame() {
            selectedConceptId = null;
            selectedMeaningId = null;
            userPairs = {};
            attemptsLeft = 3;
            isGameOver = false;

            updateAttemptsDisplay();
            renderUnifiedBoard();
