<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Infografía Interactiva: Comunicación Visual</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Cinzel:wght@700&family=Inter:wght@300;400;600;800&family=Montserrat:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;1,400&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f5ff',
                            100: '#e0ebff',
                            500: '#4f46e5',
                            600: '#4338ca',
                            700: '#3730a3',
                            900: '#1e1b4b',
                        },
                        accent: {
                            pink: '#ec4899',
                            amber: '#f59e0b',
                            cyan: '#06b6d4',
                            emerald: '#10b981'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        mono: ['Space Grotesk', 'monospace'],
                        cursive: ['Caveat', 'cursive'],
                        cinzel: ['Cinzel', 'serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* Estilos personalizados y barra de desplazamiento */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }
        
        .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .text-gradient {
            background: linear-gradient(135deg, #a855f7, #6366f1, #06b6d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .text-gradient-amber {
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        /* Clases para fuentes de demostración */
        .demo-serif { font-family: 'Playfair Display', serif; }
        .demo-sans { font-family: 'Inter', sans-serif; }
        .demo-geo { font-family: 'Space Grotesk', sans-serif; }
        .demo-script { font-family: 'Caveat', cursive; }

        /* Simulación de efecto ríos visuales */
        .river-simulation {
            word-spacing: 12px;
            text-align: justify;
            text-justify: inter-word;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white min-h-screen">

    <!-- Barra de Navegación Superior -->
    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-indigo-500/20">
                    <i class="fa-solid font-bold fa-palette"></i>
                </div>
                <div>
                    <span class="font-extrabold text-lg text-white tracking-tight">Comunicación Visual 
                    

                    <span class="hidden sm:inline-block text-xs bg-indigo-500/20 text-indigo-300 font-semibold px-2 py-0.5 rounded-full ml-2">PrepaTec</span>
                </div>
            </div>

            <nav class="hidden md:flex space-x-1 text-xs font-semibold">
                <a href="#repaso-color" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition">1. Color</a>
                <a href="#tipografia" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition">2. Tipografía (7.1)</a>
                <a href="#jerarquia" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition">3. Jerarquía (7.2)</a>
                <a href="#composicion" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition">4. Composición (7.3)</a>
                <a href="#laboratorio" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-indigo-300 hover:text-white transition">5. Laboratorio</a>
                <a href="#desafio-final" class="px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-md shadow-indigo-600/30">Desafío Final</a>
            </nav>

            <div class="md:hidden">
                <button id="mobile-menu-btn" onclick="toggleMobileMenu()" class="p-2 text-slate-400 hover:text-white focus:outline-none">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>
        <!-- Menú Desplegable Móvil -->
        <div id="mobile-menu" class="hidden md:hidden bg-slate-900 border-b border-slate-800 px-4 py-3 space-y-2">
            <a href="#repaso-color" onclick="toggleMobileMenu()" class="block py-2 text-sm text-slate-300 hover:text-white">1. Color</a>
            <a href="#tipografia" onclick="toggleMobileMenu()" class="block py-2 text-sm text-slate-300 hover:text-white">2. Tipografía (7.1)</a>
            <a href="#jerarquia" onclick="toggleMobileMenu()" class="block py-2 text-sm text-slate-300 hover:text-white">3. Jerarquía (7.2)</a>
            <a href="#composicion" onclick="toggleMobileMenu()" class="block py-2 text-sm text-slate-300 hover:text-white">4. Composición (7.3)</a>
            <a href="#laboratorio" onclick="toggleMobileMenu()" class="block py-2 text-sm text-indigo-300">5. Laboratorio</a>
            <a href="#desafio-final" onclick="toggleMobileMenu()" class="block py-2 text-sm text-indigo-400 font-bold">Desafío Final</a>
        </div>
    </header>

    <!-- Encabezado Principal (Hero Banner) -->
    <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-tr from-indigo-600/20 via-purple-600/20 to-pink-600/10 blur-3xl rounded-full pointer-events-none"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center space-x-2 bg-indigo-950/80 border border-indigo-500/30 px-4 py-1.5 rounded-full text-indigo-300 text-xs font-semibold mb-6">
                <i class="fa-solid fa-sparkles text-amber-400"></i>
                <span>Creatividad y Diseño Digital &bull; Solicitado por Erin Sandoval</span>
            </div>
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight mb-6">
                El Arte de la <span class="text-gradient">Comunicación Visual</span>
            </h1>
            <p class="max-w-3xl mx-auto text-base sm:text-xl text-slate-300 leading-relaxed font-normal mb-8">
                Aprende a transformar palabras e imágenes en <strong>piezas visuales y editoriales de alto impacto</strong>. Domina la teoría del color, las reglas tipográficas, la jerarquía visual y la composición para cautivar a tu audiencia.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="#repaso-color" class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm transition shadow-lg shadow-indigo-600/30 flex items-center gap-2">
                    <span>Iniciar Recorrido</span>
                    <i class="fa-solid fa-arrow-down"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 0: TEORÍA Y PSICOLOGÍA DEL COLOR -->
    <section id="repaso-color" class="py-16 bg-slate-900/60 border-y border-slate-800 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center space-x-3 mb-2">
                <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 text-pink-400 rounded-full text-xs font-bold uppercase tracking-wider">Punto de Partida</span>
                <span class="text-slate-400 text-xs font-medium">Recordatorio Clave</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
                0. Teoría y Psicología del Color: <span class="text-pink-400">El Lenguaje Emocional</span>
            </h2>
            <p class="text-slate-300 max-w-3xl text-sm sm:text-base mb-8">
                Antes de organizar la tipografía y las imágenes, recuerda que el <strong>color comunica emociones de forma instantánea</strong>, mucho antes de leer una sola palabra. Haz clic en las diferentes paletas para explorar su impacto psicológico:
            </p>

            <!-- Selector Interactivo de Color -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
                <!-- Selector de Tarjetas de Color -->
                <div class="lg:col-span-1 space-y-3" id="color-btn-container">
                    <button onclick="selectColorMood('rojo')" id="btn-rojo" class="w-full text-left p-4 rounded-xl glass-panel hover:border-red-500/50 transition flex items-center justify-between group border-red-500">
                        <div class="flex items-center space-x-3">
                            <span class="w-7 h-7 rounded-full bg-red-500 shadow-md shadow-red-500/50"></span>
                            <div>
                                <h3 class="font-bold text-white text-sm">Rojo: Energía y Pasión</h3>
                                <p class="text-xs text-slate-400">Enfoque inmediato, peligro, urgencia</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-red-400 transition"></i>
                    </button>

                    <button onclick="selectColorMood('azul')" id="btn-azul" class="w-full text-left p-4 rounded-xl glass-panel hover:border-blue-500/50 transition flex items-center justify-between group">
                        <div class="flex items-center space-x-3">
                            <span class="w-7 h-7 rounded-full bg-blue-500 shadow-md shadow-blue-500/50"></span>
                            <div>
                                <h3 class="font-bold text-white text-sm">Azul: Confianza y Calma</h3>
                                <p class="text-xs text-slate-400">Corporativo, tecnología, serenidad</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-blue-400 transition"></i>
                    </button>

                    <button onclick="selectColorMood('amarillo')" id="btn-amarillo" class="w-full text-left p-4 rounded-xl glass-panel hover:border-amber-400/50 transition flex items-center justify-between group">
                        <div class="flex items-center space-x-3">
                            <span class="w-7 h-7 rounded-full bg-amber-400 shadow-md shadow-amber-400/50"></span>
                            <div>
                                <h3 class="font-bold text-white text-sm">Amarillo: Optimismo e Innovación</h3>
                                <p class="text-xs text-slate-400">Luz, juventud, advertencia sutil</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-amber-400 transition"></i>
                    </button>

                    <button onclick="selectColorMood('verde')" id="btn-verde" class="w-full text-left p-4 rounded-xl glass-panel hover:border-emerald-500/50 transition flex items-center justify-between group">
                        <div class="flex items-center space-x-3">
                            <span class="w-7 h-7 rounded-full bg-emerald-500 shadow-md shadow-emerald-500/50"></span>
                            <div>
                                <h3 class="font-bold text-white text-sm">Verde: Naturaleza y Crecimiento</h3>
                                <p class="text-xs text-slate-400">Salud, sustentabilidad, frescura</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-emerald-400 transition"></i>
                    </button>

                    <button onclick="selectColorMood('morado')" id="btn-morado" class="w-full text-left p-4 rounded-xl glass-panel hover:border-purple-500/50 transition flex items-center justify-between group">
                        <div class="flex items-center space-x-3">
                            <span class="w-7 h-7 rounded-full bg-purple-500 shadow-md shadow-purple-500/50"></span>
                            <div>
                                <h3 class="font-bold text-white text-sm">Morado: Misterio y Creatividad</h3>
                                <p class="text-xs text-slate-400">Lujo, imaginación, fantasía</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-purple-400 transition"></i>
                    </button>
                </div>

                <!-- Muestra de Vista Previa -->
                <div class="lg:col-span-2 glass-panel rounded-2xl p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden border border-slate-700" id="color-preview-box">
                    <div id="color-preview-content" class="relative z-10 transition-all duration-300">
                        <!-- Contenido dinámico mediante JS -->
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 1: 7.1 FUNDAMENTOS DE TIPOGRAFÍA -->
    <section id="tipografia" class="py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center space-x-3 mb-2">
                <span class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 rounded-full text-xs font-bold uppercase tracking-wider">Sección 7.1</span>
                <span class="text-slate-400 text-xs font-medium">Fundamentos de Texto</span>
            </div>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-6">
                Fundamentos de <span class="text-gradient">Tipografía</span>
            </h2>

            <!-- Cuadro introductorio -->
            <div class="glass-panel p-6 sm:p-8 rounded-2xl mb-12 border-l-4 border-indigo-500">
                <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-font text-indigo-400"></i> Introducción: Las letras están en todas partes
                </h3>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
                    El diseño tipográfico está profundamente integrado en nuestra vida diaria: desde las etiquetas de un paquete de snacks hasta los letreros de tráfico en la autopista. Estamos constantemente rodeados de tipos de letra que otorgan perspectiva y contexto sobre marcas, espacios e ideas.
                </p>
                <p class="text-indigo-200 text-sm font-semibold bg-indigo-950/60 p-3 rounded-lg border border-indigo-500/20">
                    <i class="fa-solid fa-quote-left mr-2 text-indigo-400"></i>
                    El diseño tipográfico es el arte de crear mensajes fáciles de leer con composiciones estéticamente agradables. <strong>No requiere crear nuevas fuentes desde cero</strong>, sino dominar cómo combinar profesionalmente las existentes.
                </p>
            </div>

            <!-- Cuadrícula de Estilos -->
            <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
                <i class="fa-solid fa-layer-group text-pink-400"></i> Estilos Tipográficos
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
                <!-- Tarjeta Serif -->
                <div class="glass-panel p-6 rounded-2xl hover:border-indigo-500/50 transition group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-serif text-2xl font-bold mb-4 border border-amber-500/20">
                            Ag
                        </div>
                        <h4 class="text-lg font-bold text-white mb-2">Serif (Con Remates / Serifa)</h4>
                        <p class="text-xs text-slate-300 leading-relaxed mb-4">
                            Arraigada en la caligrafía tradicional. Incluye trazos decorativos o "pies" en los extremos de los caracteres.
                        </p>
                        <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800 text-center mb-3">
                            <span class="demo-serif text-2xl font-bold text-amber-200">Clásico y Formal</span>
                        </div>
                    </div>
                    <span class="text-[11px] text-amber-400/90 font-medium bg-amber-500/10 px-2.5 py-1 rounded-full text-center">
                        Ideal para: Libros impresos y textos largos
                    </span>
                </div>

                <!-- Tarjeta Sans Serif -->
                <div class="glass-panel p-6 rounded-2xl hover:border-indigo-500/50 transition group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-sans text-2xl font-bold mb-4 border border-indigo-500/20">
                            Ag
                        </div>
                        <h4 class="text-lg font-bold text-white mb-2">Sans Serif (Palo Seco)</h4>
                        <p class="text-xs text-slate-300 leading-relaxed mb-4">
                            Carece de remates decorativos. Líneas limpias y modernas con gran versatilidad en pantallas.
                        </p>
                        <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800 text-center mb-3">
                            <span class="demo-sans text-xl font-bold text-indigo-300">Moderno y Limpio</span>
                        </div>
                    </div>
                    <span class="text-[11px] text-indigo-400/90 font-medium bg-indigo-500/10 px-2.5 py-1 rounded-full text-center">
                        Ideal para: Pantallas digitales y titulares
                    </span>
                </div>

                <!-- Tarjeta Geométrica -->
                <div class="glass-panel p-6 rounded-2xl hover:border-indigo-500/50 transition group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-mono text-2xl font-bold mb-4 border border-cyan-500/20">
                            OAN
                        </div>
                        <h4 class="text-lg font-bold text-white mb-2">Geométrica</h4>
                        <p class="text-xs text-slate-300 leading-relaxed mb-4">
                            Construida a partir de formas geométricas puras. La "O" es un círculo perfecto con ángulos afilados.
                        </p>
                        <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800 text-center mb-3">
                            <span class="demo-geo text-xl font-bold text-cyan-300">Estructura Pura</span>
                        </div>
                    </div>
                    <span class="text-[11px] text-cyan-400/90 font-medium bg-cyan-500/10 px-2.5 py-1 rounded-full text-center">
                        Ideal para: Logotipos y diseño futurista
                    </span>
                </div>

                <!-- Tarjeta Cursiva/Script -->
                <div class="glass-panel p-6 rounded-2xl hover:border-indigo-500/50 transition group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-pink-500/10 text-pink-400 flex items-center justify-center font-cursive text-3xl mb-4 border border-pink-500/20">
                            Script
                        </div>
                        <h4 class="text-lg font-bold text-white mb-2">Script (Cursiva / Manuscrita)</h4>
                        <p class="text-xs text-slate-300 leading-relaxed mb-4">
                            Imita la caligrafía manual y la caligrafía artística. Puede ir desde caligrafía elegante hasta trazos casuales.
                        </p>
                        <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800 text-center mb-3">
                            <span class="demo-script text-2xl text-pink-300">Manuscrito</span>
                        </div>
                    </div>
                    <span class="text-[11px] text-pink-400/90 font-medium bg-pink-500/10 px-2.5 py-1 rounded-full text-center">
                        Uso moderado: Títulos o acentos
                    </span>
                </div>
            </div>

            <!-- Errores de Maquetación -->
            <div class="glass-panel p-8 rounded-3xl mb-16 border border-slate-700">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                    <div>
                        <span class="text-xs font-bold text-amber-400 tracking-wider uppercase">¡Advertencia de Maquetación!</span>
                        <h3 class="text-2xl font-extrabold text-white">Líneas Viudas, Huérfanas, Runt y Ríos Visuales</h3>
                        <p class="text-slate-400 text-sm">Errores comunes de formato que interrumpen la lectura y desordenan el diseño de página.</p>
                    </div>
                    <div class="inline-flex p-1 bg-slate-900 rounded-xl border border-slate-800 self-start">
                        <button onclick="toggleTypographyErrorView('error')" id="btn-view-error" class="px-4 py-2 text-xs font-bold rounded-lg bg-red-500/20 text-red-300 border border-red-500/40">
                            <i class="fa-solid fa-bug mr-1"></i> Ver Errores
                        </button>
                        <button onclick="toggleTypographyErrorView('correct')" id="btn-view-correct" class="px-4 py-2 text-xs font-bold rounded-lg text-slate-400 hover:text-white">
                            <i class="fa-solid fa-circle-check mr-1"></i> Ver Solución
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="errors-container">
                    <!-- Viuda -->
                    <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <h4 class="font-bold text-white text-base">Línea Viuda</h4>
                                <span id="tag-viuda" class="badge-status text-[10px] px-2 py-0.5 rounded bg-red-500/20 text-red-400 border border-red-500/30">Error</span>
                            </div>
                            <p class="text-xs text-slate-400 mb-4">
                                La <strong>última línea</strong> de un párrafo queda aislada en la parte superior de una nueva columna o página.
                            </p>
                            <div class="p-3 bg-white text-slate-900 rounded-xl text-xs font-sans shadow-inner min-h-[130px] flex flex-col justify-between" id="box-viuda">
                                <!-- Poblado por JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Huérfana -->
                    <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <h4 class="font-bold text-white text-base">Línea Huérfana</h4>
                                <span id="tag-huerfana" class="badge-status text-[10px] px-2 py-0.5 rounded bg-red-500/20 text-red-400 border border-red-500/30">Error</span>
                            </div>
                            <p class="text-xs text-slate-400 mb-4">
                                La <strong>primera línea</strong> de un párrafo queda aislada al final de una columna o página.
                            </p>
                            <div class="p-3 bg-white text-slate-900 rounded-xl text-xs font-sans shadow-inner min-h-[130px] flex flex-col justify-between" id="box-huerfana">
                                <!-- Poblado por JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Runt -->
                    <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
