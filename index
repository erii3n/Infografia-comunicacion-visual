        function updateAttemptsDisplay() {
            const container = document.getElementById('attempts-display');
            container.innerHTML = '';

            for (let i = 0; i < 3; i++) {
                if (i < attemptsLeft) {
                    container.innerHTML += `<i class="fa-solid fa-heart text-red-500 text-lg"></i>`;
                } else {
                    container.innerHTML += `<i class="fa-regular fa-heart text-slate-600 text-lg"></i>`;
                }
            }

            const iconBox = document.getElementById('game-attempts-icon');
            if (attemptsLeft === 1) {
                iconBox.className = "w-12 h-12 rounded-xl bg-red-500/30 text-red-400 flex items-center justify-center text-xl font-bold border border-red-500/50 animate-pulse";
            } else {
                iconBox.className = "w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-xl font-bold border border-amber-500/30";
            }

            updateMatchesScore();
        }

        function updateMatchesScore() {
            const matchedCount = Object.keys(userPairs).length;
            document.getElementById('matches-score').innerText = `${matchedCount} / ${UNIFIED_CONCEPTS.length} Emparejados`;
        }

        // Función de ordenamiento aleatorio
        function shuffleArray(array) {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        let currentShuffledMeanings = shuffleArray(UNIFIED_MEANINGS);

        function renderUnifiedBoard() {
            const conceptsContainer = document.getElementById('concepts-list');
            const definitionsContainer = document.getElementById('definitions-list');

            conceptsContainer.innerHTML = '';
            definitionsContainer.innerHTML = '';

            // Renderizar Conceptos
            UNIFIED_CONCEPTS.forEach(c => {
                const isSelected = selectedConceptId === c.id;
                const pairedMeaningId = userPairs[c.id];

                let borderClass = "border-slate-800 bg-slate-900/80 hover:border-slate-600";
                if (isSelected) {
                    borderClass = "border-indigo-500 bg-indigo-950/80 ring-2 ring-indigo-500/50";
                } else if (pairedMeaningId) {
                    borderClass = "border-pink-500/60 bg-slate-900/90";
                }

                conceptsContainer.innerHTML += `
                    <div onclick="handleConceptClick(${c.id})" class="p-3.5 rounded-xl border ${borderClass} transition cursor-pointer flex items-center justify-between group">
                        <div>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-400 block">${c.category}</span>
                            <span class="font-bold text-white text-sm sm:text-base">${c.concept}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            ${pairedMeaningId ? '<i class="fa-solid fa-link text-pink-400 text-xs"></i>' : ''}
                            <i class="fa-solid fa-chevron-right text-xs text-slate-600 group-hover:text-slate-300"></i>
                        </div>
                    </div>
                `;
            });

            // Renderizar Definiciones
            currentShuffledMeanings.forEach(m => {
                const isSelected = selectedMeaningId === m.id;
                const isPairedWithConceptId = Object.keys(userPairs).find(cId => userPairs[cId] === m.id);

                let borderClass = "border-slate-800 bg-slate-900/80 hover:border-slate-600";
                if (isSelected) {
                    borderClass = "border-pink-500 bg-pink-950/80 ring-2 ring-pink-500/50";
                } else if (isPairedWithConceptId) {
                    borderClass = "border-pink-500/60 bg-slate-900/90";
                }

                definitionsContainer.innerHTML += `
                    <div onclick="handleMeaningClick(${m.id})" class="p-3.5 rounded-xl border ${borderClass} transition cursor-pointer flex items-center justify-between group">
                        <p class="text-xs sm:text-sm text-slate-200 leading-relaxed pr-2">${m.text}</p>
                        <div class="shrink-0">
                            ${isPairedWithConceptId ? '<i class="fa-solid fa-check text-pink-400 text-xs"></i>' : '<i class="fa-regular fa-circle text-xs text-slate-600"></i>'}
                        </div>
                    </div>
                `;
            });

            updateMatchesScore();
        }

        function handleConceptClick(conceptId) {
            if (isGameOver) return;

            if (selectedConceptId === conceptId) {
                selectedConceptId = null;
            } else {
                selectedConceptId = conceptId;
            }

            tryPairing();
            renderUnifiedBoard();
        }

        function handleMeaningClick(meaningId) {
            if (isGameOver) return;

            if (selectedMeaningId === meaningId) {
                selectedMeaningId = null;
            } else {
                selectedMeaningId = meaningId;
            }

            tryPairing();
            renderUnifiedBoard();
        }

        function tryPairing() {
            if (selectedConceptId && selectedMeaningId) {
                // Eliminar si la definición ya estaba asignada a otro concepto
                Object.keys(userPairs).forEach(cId => {
                    if (userPairs[cId] === selectedMeaningId) {
                        delete userPairs[cId];
                    }
                });

                // Asignar pareja
                userPairs[selectedConceptId] = selectedMeaningId;

                // Reiniciar selección
                selectedConceptId = null;
                selectedMeaningId = null;
            }
        }

        function verifyUnifiedGame() {
            if (isGameOver) return;

            const pairedCount = Object.keys(userPairs).length;
            if (pairedCount < UNIFIED_CONCEPTS.length) {
                showModal(
                    '<i class="fa-solid fa-triangle-exclamation text-amber-400"></i>',
                    'Incompleto',
                    `Has emparejado ${pairedCount} de ${UNIFIED_CONCEPTS.length} conceptos. Por favor completa todas las parejas antes de verificar.`
                );
                return;
            }

            // Calcular aciertos
            let correctCount = 0;
            UNIFIED_CONCEPTS.forEach(c => {
                if (userPairs[c.id] === c.meaningId) {
                    correctCount++;
                }
            });

            if (correctCount === UNIFIED_CONCEPTS.length) {
                // ¡Victoria!
                isGameOver = true;
                showModal(
                    '<div class="w-full h-full rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center"><i class="fa-solid fa-trophy"></i></div>',
                    '¡Excelente Trabajo!',
                    `¡Lograste un puntaje perfecto de <strong>${correctCount}/${UNIFIED_CONCEPTS.length}</strong>! Has dominado los conceptos de Comunicación Visual.`,
                    '¡Genial!'
                );
            } else {
                // Error cometido
                attemptsLeft--;
                updateAttemptsDisplay();

                if (attemptsLeft > 0) {
                    showModal(
                        '<div class="w-full h-full rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></div>',
                        'Coincidencias Incorrectas',
                        `Tuviste <strong>${correctCount} de ${UNIFIED_CONCEPTS.length}</strong> correctas.<br>Te quedan <strong>${attemptsLeft} intento(s)</strong>. Revisa tus parejas e inténtalo de nuevo.`,
                        'Intentar de nuevo'
                    );
                } else {
                    // Sin intentos
                    isGameOver = true;
                    showModal(
                        '<div class="w-full h-full rounded-full bg-red-500/20 text-red-400 flex items-center justify-center"><i class="fa-solid fa-skull"></i></div>',
                        'Sin Intentos Restantes',
                        `Te has quedado sin intentos (Puntaje: ${correctCount}/${UNIFIED_CONCEPTS.length}). Puedes reiniciar la actividad para intentar superar tu marca.`,
                        'Reiniciar Actividad'
                    );
                }
            }
        }

        function resetUnifiedGame() {
            currentShuffledMeanings = shuffleArray(UNIFIED_MEANINGS);
            initUnifiedGame();
        }

        function showModal(iconHtml, title, message, btnText = "Aceptar") {
            document.getElementById('modal-icon').innerHTML = iconHtml;
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-message').innerHTML = message;
            document.getElementById('modal-action-btn').innerText = btnText;
            document.getElementById('game-modal').classList.remove('hidden');
            document.getElementById('game-modal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('game-modal').classList.add('hidden');
            document.getElementById('game-modal').classList.remove('flex');

            if (attemptsLeft <= 0) {
                resetUnifiedGame();
            }
        }

        // Inicializar vistas por defecto al cargar la página
        window.onload = function() {
            selectColorMood('rojo');
            toggleTypographyErrorView('error');
            initUnifiedGame();
            updateLabPreview();
        };
    </script>
</body>
</html>
